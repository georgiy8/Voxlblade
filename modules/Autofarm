return function(Window, meta)

    ------------------------------------------------------------
    -- Services
    ------------------------------------------------------------

    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")

    local LocalPlayer = Players.LocalPlayer

    ------------------------------------------------------------
    -- Configuration
    ------------------------------------------------------------

    local TAB_NAME = "BuniFarm"
    local TAB_ICON = "🐰"

    local DEFAULT_SPEED = 80
    local MIN_SPEED = 1
    local MAX_SPEED = 500

    local SCAN_INTERVAL = 0.15

    ------------------------------------------------------------
    -- Mob list
    ------------------------------------------------------------

    local MobNames = {
        "Buni",
        "DireBuni",
        "PlainsWoof",
        "Mageling",
        "Croakernaut",
        "LordFrogg",
        "Bulfrogg",
        "Toadzerker",
        "Dragigator",
        "Lilimonster",
        "Drone",
        "Bumblz",
        "Bomber",
        "QueenBumblz",
        "Puffball",
        "SporeBossMan",
        "Sporeling",
        "Lord Stratos Altolodon",
        "Whirlray",
        "Caci",
        "Slizard",
        "CaciKing",
        "StoneCleric",
        "VoidRoot",
        "Bowldur",
        "BastionGuardian",
        "StoneArcher",
        "StoneKnight",
        "CrazyHare",
        "BaniPrince",
        "RedRockHare",
        "Batty",
        "GlacialSnapper",
        "WinterWoof",
        "Delta-Spider",
        "Stalker",
        "Scow",
        "SteamGolem",
        "Omega-Batty",
        "DeepSpider",
        "BrainBurner",
        "Proto-Mungus",
        "Easter",
        "Grumpkin",
        "THEHALLOWSOUL"
    }

    ------------------------------------------------------------
    -- Lookup
    ------------------------------------------------------------

    local MobLookup = {}

    for _, mobName in ipairs(MobNames) do
        MobLookup[mobName] = true
    end

    ------------------------------------------------------------
    -- State
    ------------------------------------------------------------

    local Running = false
    local TweenSpeed = DEFAULT_SPEED

    local CurrentTween = nil
    local CurrentTarget = nil

    local SelectedMobs = {}

    -- Все мобы включены по умолчанию.
    for _, mobName in ipairs(MobNames) do
        SelectedMobs[mobName] = true
    end

    ------------------------------------------------------------
    -- Character helpers
    ------------------------------------------------------------

    local function GetCharacter()
        return LocalPlayer.Character
    end

    local function GetRoot()
        local Character = GetCharacter()

        if not Character then
            return nil
        end

        return Character:FindFirstChild("HumanoidRootPart")
    end

    ------------------------------------------------------------
    -- Mob name handling
    ------------------------------------------------------------

    local function GetMobType(Name)
        if not Name then
            return nil
        end

        -- Сначала точное совпадение.
        if MobLookup[Name] then
            return Name
        end

        -- Убираем случайные цифры в конце:
        -- Buni07       -> Buni
        -- Buni42       -> Buni
        -- Omega-Batty05 -> Omega-Batty
        local BaseName = Name:gsub("%d+$", "")

        if MobLookup[BaseName] then
            return BaseName
        end

        return nil
    end

    ------------------------------------------------------------
    -- Mob validation
    ------------------------------------------------------------

    local function GetHitbox(Mob)
        if not Mob or not Mob.Parent then
            return nil
        end

        local Hitbox = Mob:FindFirstChild("Hitbox")

        if not Hitbox then
            return nil
        end

        if not Hitbox:IsA("BasePart") then
            return nil
        end

        return Hitbox
    end

    local function IsValidMob(Mob)
        if not Mob then
            return false
        end

        if not Mob.Parent then
            return false
        end

        if not Mob:IsA("BasePart") then
            return false
        end

        local MobType = GetMobType(Mob.Name)

        if not MobType then
            return false
        end

        if not SelectedMobs[MobType] then
            return false
        end

        local Hitbox = GetHitbox(Mob)

        if not Hitbox then
            return false
        end

        return true
    end

    ------------------------------------------------------------
    -- Find closest mob
    ------------------------------------------------------------

    local function FindClosestMob()
        local Root = GetRoot()

        if not Root then
            return nil
        end

        local ClosestMob = nil
        local ClosestDistance = math.huge

        for _, Object in ipairs(workspace:GetDescendants()) do

            if IsValidMob(Object) then

                local Hitbox = GetHitbox(Object)

                if Hitbox then
                    local Distance = (Root.Position - Hitbox.Position).Magnitude

                    if Distance < ClosestDistance then
                        ClosestDistance = Distance
                        ClosestMob = Object
                    end
                end
            end
        end

        return ClosestMob
    end

    ------------------------------------------------------------
    -- Stop current tween
    ------------------------------------------------------------

    local function StopTween()
        if CurrentTween then
            pcall(function()
                CurrentTween:Cancel()
            end)
        end

        CurrentTween = nil
    end

    ------------------------------------------------------------
    -- Tween to target
    ------------------------------------------------------------

    local function TweenToMob(Mob)

        if not Running then
            return
        end

        if not IsValidMob(Mob) then
            return
        end

        local Root = GetRoot()

        if not Root then
            return
        end

        local Hitbox = GetHitbox(Mob)

        if not Hitbox then
            return
        end

        CurrentTarget = Mob

        local Distance = (Root.Position - Hitbox.Position).Magnitude

        -- Уже практически на месте.
        if Distance <= 1 then
            CurrentTarget = nil
            return
        end

        local Duration = Distance / math.max(TweenSpeed, 1)

        StopTween()

        local TweenInfoData = TweenInfo.new(
            Duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        )

        CurrentTween = TweenService:Create(
            Root,
            TweenInfoData,
            {
                CFrame = Hitbox.CFrame
            }
        )

        local Tween = CurrentTween

        local Connection

        Connection = Tween.Completed:Connect(function()
            if Connection then
                Connection:Disconnect()
                Connection = nil
            end

            if CurrentTween == Tween then
                CurrentTween = nil
            end

            if CurrentTarget == Mob then
                CurrentTarget = nil
            end
        end)

        Tween:Play()

        -- Следим за исчезновением цели/Hitbox/персонажа.
        while Running and CurrentTween == Tween do

            local Character = GetCharacter()
            local CurrentRoot = Character and Character:FindFirstChild("HumanoidRootPart")

            if not Character
                or not Character.Parent
                or not CurrentRoot
                or not CurrentRoot.Parent
            then
                Tween:Cancel()
                break
            end

            if not Mob
                or not Mob.Parent
            then
                Tween:Cancel()
                break
            end

            local CurrentHitbox = GetHitbox(Mob)

            if not CurrentHitbox
                or not CurrentHitbox.Parent
            then
                Tween:Cancel()
                break
            end

            if not SelectedMobs[GetMobType(Mob.Name)] then
                Tween:Cancel()
                break
            end

            task.wait(0.05)
        end

        if Connection then
            Connection:Disconnect()
        end

        if CurrentTween == Tween then
            CurrentTween = nil
        end

        if CurrentTarget == Mob then
            CurrentTarget = nil
        end
    end

    ------------------------------------------------------------
    -- Farm loop
    ------------------------------------------------------------

    task.spawn(function()

        while true do

            if Running then

                local Target = FindClosestMob()

                if Target then
                    TweenToMob(Target)
                else
                    task.wait(SCAN_INTERVAL)
                end

            else
                task.wait(0.1)
            end

        end

    end)

    ------------------------------------------------------------
    -- Public controls
    ------------------------------------------------------------

    local function Start()
        if Running then
            return
        end

        Running = true
    end

    local function Stop()
        Running = false

        StopTween()

        CurrentTarget = nil
    end

    ------------------------------------------------------------
    -- UI
    ------------------------------------------------------------

    local Tab = Window:CreateTab({
        Name = TAB_NAME,
        Icon = TAB_ICON,
        Order = (meta and meta.Order) or 30,
    })

    ------------------------------------------------------------
    -- Main section
    ------------------------------------------------------------

    local Main = Tab:CreateSection({
        Name = "Mob Farm"
    })

    Main:AddLabel({
        Text = "BuniFarm"
    })

    Main:AddLabel({
        Text = "Moves to selected mob Hitboxes"
    })

    Main:AddSeparator()

    ------------------------------------------------------------
    -- Enable / Disable
    ------------------------------------------------------------

    Main:AddToggle({
        Text = "Enable Farm",
        Default = false,

        Callback = function(Value)

            if Value then
                Start()
            else
                Stop()
            end

        end
    })

    ------------------------------------------------------------
    -- Speed
    ------------------------------------------------------------

    Main:AddSlider({
        Text = "Tween Speed",
        Min = MIN_SPEED,
        Max = MAX_SPEED,
        Default = DEFAULT_SPEED,
        Increment = 1,

        Callback = function(Value)
            TweenSpeed = Value

            -- Чтобы изменение скорости сразу применилось
            -- к текущему перемещению.
            if Running and CurrentTarget then
                local Target = CurrentTarget

                StopTween()

                task.defer(function()
                    if Running and Target and Target.Parent then
                        TweenToMob(Target)
                    end
                end)
            end
        end
    })

    ------------------------------------------------------------
    -- Mob selection
    ------------------------------------------------------------

    local MobSection = Tab:CreateSection({
        Name = "Mob Selection"
    })

    MobSection:AddDropdown({
        Text = "Mob Types",

        Options = MobNames,

        MultiSelect = true,

        Callback = function(Value)

            -- В твоём Dropdown MultiSelect callback
            -- возвращает массив выбранных значений.
            SelectedMobs = {}

            for _, MobName in ipairs(Value) do
                if MobLookup[MobName] then
                    SelectedMobs[MobName] = true
                end
            end

            -- Если текущая цель больше не выбрана,
            -- немедленно прекращаем её tween.
            if CurrentTarget then
                local CurrentType = GetMobType(CurrentTarget.Name)

                if not CurrentType or not SelectedMobs[CurrentType] then
                    StopTween()
                    CurrentTarget = nil
                end
            end

        end
    })

    ------------------------------------------------------------
    -- Controls
    ------------------------------------------------------------

    local Controls = Tab:CreateSection({
        Name = "Controls"
    })

    Controls:AddButton({
        Text = "Start",
        Callback = function()
            Start()
        end
    })

    Controls:AddButton({
        Text = "Stop",
        Callback = function()
            Stop()
        end
    })

    ------------------------------------------------------------
    -- Keybind
    ------------------------------------------------------------

    Controls:AddKeybind({
        Text = "Toggle Farm",
        Default = Enum.KeyCode.F,

        Callback = function()

            if Running then
                Stop()
            else
                Start()
            end

        end
    })

    ------------------------------------------------------------
    -- Status
    ------------------------------------------------------------

    local Status = Tab:CreateSection({
        Name = "Status"
    })

    local StatusLabel = Status:AddLabel({
        Text = "Status: OFF"
    })

    ------------------------------------------------------------
    -- Status updater
    ------------------------------------------------------------

    task.spawn(function()

        while true do

            local Text

            if not Running then

                Text = "Status: OFF"

            elseif CurrentTarget then

                local MobType = GetMobType(CurrentTarget.Name)

                if MobType then
                    Text = "Status: FARMING | " .. MobType
                else
                    Text = "Status: FARMING"
                end

            else

                Text = "Status: SEARCHING"

            end

            pcall(function()
                StatusLabel:SetText(Text)
            end)

            task.wait(0.1)

        end

    end)

end
