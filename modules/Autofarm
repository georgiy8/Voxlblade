--[[
    BuniFarm.lua
    Universal Modular Utility

    Tab:
        Name  = "BuniFarm"
        Icon  = "🐰"
        Order = 30

    Description:
        Finds selected mobs in Workspace, gets their Hitbox,
        tweens the player to the target and automatically
        switches to another target when the current one disappears.
]]

local BuniFarm = {}

--// Services
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

--//========================================================
--// CONFIG
--//========================================================

local TAB_NAME = "BuniFarm"
local TAB_ICON = "🐰"
local TAB_ORDER = 15

local SECTION_NAME = "Mob Farm"

local DEFAULT_TWEEN_SPEED = 80
local MIN_TWEEN_SPEED = 1
local MAX_TWEEN_SPEED = 500

local SCAN_INTERVAL = 0.15

--//========================================================
--// MOB LIST
--//========================================================

local MobNames = {
    "Buni",
    "DireBuni",
    "PlainsWoof",
    "Mageling",
    "Croakernaut",
    "LordFrogg",
    "Bulfrogg",
    "Toadzerker",
    "Dragigator",
    "Lilimonster",
    "Drone",
    "Bumblz",
    "Bomber",
    "QueenBumblz",
    "Puffball",
    "SporeBossMan",
    "Sporeling",
    "Lord Stratos Altolodon",
    "Whirlray",
    "Caci",
    "Slizard",
    "CaciKing",
    "StoneCleric",
    "VoidRoot",
    "Bowldur",
    "BastionGuardian",
    "StoneArcher",
    "StoneKnight",
    "CrazyHare",
    "BaniPrince",
    "RedRockHare",
    "Batty",
    "GlacialSnapper",
    "WinterWoof",
    "Delta-Spider",
    "Stalker",
    "Scow",
    "SteamGolem",
    "Omega-Batty",
    "DeepSpider",
    "BrainBurner",
    "Proto-Mungus",
    "Easter",
    "Grumpkin",
    "THEHALLOWSOUL",
}

local MobLookup = {}

for _, MobName in ipairs(MobNames) do
    MobLookup[MobName] = true
end

--//========================================================
--// STATE
--//========================================================

local Running = false

local TweenSpeed = DEFAULT_TWEEN_SPEED

local CurrentTween = nil
local CurrentTarget = nil

local SelectedMobs = {}

local StartButton = nil
local StatusLabel = nil

-- Select all mobs by default.
for _, MobName in ipairs(MobNames) do
    SelectedMobs[MobName] = true
end

--//========================================================
--// CHARACTER
--//========================================================

local function GetCharacter()
    return LocalPlayer.Character
end

local function GetRoot()
    local Character = GetCharacter()

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

--//========================================================
--// MOB TYPE
--//========================================================

-- Supports:
--
-- Buni
-- Buni07
-- Buni42
--
-- Omega-Batty
-- Omega-Batty05
--
-- etc.

local function GetMobType(Object)
    if not Object then
        return nil
    end

    if not Object:IsA("BasePart") then
        return nil
    end

    -- Exact name.
    if MobLookup[Object.Name] then
        return Object.Name
    end

    -- Remove trailing numbers.
    local BaseName = Object.Name:gsub("%d+$", "")

    if MobLookup[BaseName] then
        return BaseName
    end

    return nil
end

--//========================================================
--// MOB VALIDATION
--//========================================================

local function IsValidMob(Object)
    if not Object then
        return false
    end

    if not Object.Parent then
        return false
    end

    local MobType = GetMobType(Object)

    if not MobType then
        return false
    end

    if not SelectedMobs[MobType] then
        return false
    end

    local Hitbox = Object:FindFirstChild("Hitbox")

    if not Hitbox then
        return false
    end

    if not Hitbox:IsA("BasePart") then
        return false
    end

    return true
end

--//========================================================
--// FIND CLOSEST MOB
--//========================================================

local function FindClosestMob()
    local Root = GetRoot()

    if not Root then
        return nil
    end

    local ClosestMob = nil
    local ClosestDistance = math.huge

    for _, Object in ipairs(workspace:GetDescendants()) do
        if IsValidMob(Object) then
            local Hitbox = Object:FindFirstChild("Hitbox")

            if Hitbox and Hitbox:IsA("BasePart") then
                local Distance = (
                    Root.Position - Hitbox.Position
                ).Magnitude

                if Distance < ClosestDistance then
                    ClosestDistance = Distance
                    ClosestMob = Object
                end
            end
        end
    end

    return ClosestMob
end

--//========================================================
--// TWEEN CONTROL
--//========================================================

local function StopTween()
    if CurrentTween then
        pcall(function()
            CurrentTween:Cancel()
        end)

        CurrentTween = nil
    end
end

--//========================================================
--// STATUS
--//========================================================

local function SetStatus(Text)
    if StatusLabel then
        StatusLabel:SetText("Status: " .. Text)
    end
end

--//========================================================
--// TWEEN TO MOB
--//========================================================

local function TweenToMob(Mob)
    if not Running then
        return false
    end

    if not IsValidMob(Mob) then
        return false
    end

    local Root = GetRoot()

    if not Root then
        return false
    end

    local Hitbox = Mob:FindFirstChild("Hitbox")

    if not Hitbox or not Hitbox:IsA("BasePart") then
        return false
    end

    CurrentTarget = Mob

    local Distance = (
        Root.Position - Hitbox.Position
    ).Magnitude

    -- Already at target.
    if Distance <= 2 then
        return true
    end

    StopTween()

    local Duration = math.max(
        Distance / TweenSpeed,
        0.05
    )

    CurrentTween = TweenService:Create(
        Root,

        TweenInfo.new(
            Duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),

        {
            CFrame = Hitbox.CFrame
        }
    )

    local Completed = false
    local Connection = nil

    Connection = CurrentTween.Completed:Connect(function()
        Completed = true

        if Connection then
            Connection:Disconnect()
            Connection = nil
        end
    end)

    CurrentTween:Play()

    -- Watch target while tweening.
    while Running and not Completed do
        task.wait(0.05)

        -- Mob disappeared.
        if not Mob.Parent then
            StopTween()
            break
        end

        -- Hitbox disappeared.
        Hitbox = Mob:FindFirstChild("Hitbox")

        if not Hitbox or not Hitbox:IsA("BasePart") then
            StopTween()
            break
        end

        -- Character disappeared/reset.
        Root = GetRoot()

        if not Root then
            StopTween()
            break
        end
    end

    if Connection then
        Connection:Disconnect()
        Connection = nil
    end

    CurrentTween = nil
    CurrentTarget = nil

    return Completed
end

--//========================================================
--// FARM LOOP
--//========================================================

local function FarmLoop()
    while Running do

        local Character = GetCharacter()
        local Root = GetRoot()

        if not Character or not Root then
            SetStatus("Waiting for character...")
            task.wait(0.5)

            continue
        end

        local Target = FindClosestMob()

        if Target then

            CurrentTarget = Target

            local MobType = GetMobType(Target)

            SetStatus(
                "Farming: " .. tostring(MobType)
            )

            TweenToMob(Target)

            if Running then
                task.wait(0.05)
            end

        else

            CurrentTarget = nil

            SetStatus(
                "Searching for selected mobs..."
            )

            task.wait(SCAN_INTERVAL)
        end
    end

    StopTween()

    CurrentTarget = nil

    SetStatus("Stopped")
end

--//========================================================
--// PUBLIC API
--//========================================================

function BuniFarm.Start()

    if Running then
        return
    end

    Running = true

    if StartButton then
        StartButton:SetText("Stop BuniFarm")
    end

    SetStatus("Starting...")

    task.spawn(FarmLoop)
end

function BuniFarm.Stop()

    Running = false

    StopTween()

    CurrentTarget = nil

    if StartButton then
        StartButton:SetText("Start BuniFarm")
    end

    SetStatus("Stopped")
end

function BuniFarm.IsRunning()
    return Running
end

--// Speed
function BuniFarm.SetSpeed(Speed)

    Speed = tonumber(Speed)

    if not Speed then
        return
    end

    TweenSpeed = math.clamp(
        Speed,
        MIN_TWEEN_SPEED,
        MAX_TWEEN_SPEED
    )
end

function BuniFarm.GetSpeed()
    return TweenSpeed
end

--// Single mob toggle
function BuniFarm.SetMobEnabled(MobName, Enabled)

    if not MobLookup[MobName] then
        return
    end

    SelectedMobs[MobName] = Enabled == true
end

--// MultiSelect setter
function BuniFarm.SetSelectedMobs(Values)

    table.clear(SelectedMobs)

    if type(Values) ~= "table" then
        return
    end

    for _, MobName in ipairs(Values) do

        if MobLookup[MobName] then
            SelectedMobs[MobName] = true
        end

    end
end

--// Get selected mobs as an array.
function BuniFarm.GetSelectedMobs()

    local Result = {}

    for _, MobName in ipairs(MobNames) do

        if SelectedMobs[MobName] then
            table.insert(Result, MobName)
        end

    end

    return Result
end

function BuniFarm.GetCurrentTarget()
    return CurrentTarget
end

function BuniFarm.GetMobNames()
    return table.clone(MobNames)
end

--//========================================================
--// CREATE UI
--//========================================================

function BuniFarm.CreateUI(Section)

    if not Section then
        return
    end

    -- Header
    Section:AddLabel({
        Text = "BuniFarm"
    })

    Section:AddLabel({
        Text = "Automatically farms selected mobs"
    })

    -- Start / Stop
    StartButton = Section:AddButton({
        Text = "Start BuniFarm",

        Callback = function()

            if Running then
                BuniFarm.Stop()
            else
                BuniFarm.Start()
            end

        end
    })

    Section:AddSeparator({
        Text = "Target Selection"
    })

    -- IMPORTANT:
    -- This is strictly compatible with the uploaded
    -- Dropdown implementation.
    --
    -- MultiSelect callback returns:
    --
    -- {
    --     "Buni",
    --     "DireBuni",
    --     "Puffball"
    -- }
    --
    -- Default must also be an array.

    Section:AddDropdown({

        Text = "Mob Types",

        Values = MobNames,

        MultiSelect = true,

        Default = MobNames,

        Callback = function(Values)

            BuniFarm.SetSelectedMobs(Values)

        end
    })

    Section:AddSeparator({
        Text = "Movement"
    })

    Section:AddSlider({

        Text = "Tween Speed",

        Min = MIN_TWEEN_SPEED,

        Max = MAX_TWEEN_SPEED,

        Default = DEFAULT_TWEEN_SPEED,

        Increment = 1,

        Callback = function(Value)

            BuniFarm.SetSpeed(Value)

        end
    })

    StatusLabel = Section:AddLabel({
        Text = "Status: Stopped"
    })

    return BuniFarm
end

--//========================================================
--// CREATE TAB
--//========================================================

function BuniFarm.CreateTab(Window)

    if not Window then
        return nil
    end

    local Tab = Window:CreateTab({

        Name = TAB_NAME,

        Icon = TAB_ICON,

        Order = TAB_ORDER
    })

    local Section = Tab:CreateSection({

        Name = SECTION_NAME
    })

    BuniFarm.CreateUI(Section)

    return Tab
end

return BuniFarm
