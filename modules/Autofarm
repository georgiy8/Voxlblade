--========================================================--
-- Autofarm Module
-- CFly to the enemy Hitbox (MeshPart), swing sword + weapon art every N ms.
-- Priority dropdown picks mutated enemies (Bloody/Corrupt/Legendary/Magical)
-- before any non-mutated target.
--========================================================--

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

local Events     = ReplicatedStorage:WaitForChild("Events")
local SwingSword = Events:WaitForChild("SwingSword")
local WeaponArt  = Events:WaitForChild("WeaponArt")

local ENEMY_LIST = {
    "Buni", "DireBuni", "PlainsWoof", "Mageling", "Croakernaut", "LordFrogg",
    "Bulfrogg", "Toadzerker", "Dragigator", "Lilimonster", "Drone", "Bumblz",
    "Bomber", "QueenBumblz", "Puffball", "SporeBossMan", "Sporeling",
    "Lord Stratos Altolodon", "Whirlray", "Caci", "Slizard", "CaciKing",
    "StoneCleric", "VoidRoot", "Bowldur", "BastionGuardian", "StoneArcher",
    "StoneKnight", "CrazyHare", "BaniPrince", "RedRockHare", "Batty",
    "GlacialSnapper", "WinterWoof", "Delta-Spider", "Stalker", "Scow",
    "SteamGolem", "Omega-Batty", "DeepSpider", "BrainBurner", "Proto-Mungus",
    "Easter", "Buni", "Grumpkin", "THEHALLOWSOUL"
}

-- For each mutation name the enemy must have BOTH:
--   ParticleEmitter named <Mutation> with Enabled = true
--   PointLight      named <Mutation>L with Enabled = true
local MUTATION_LIST = { "Bloody", "Corrupt", "Legendary", "Magical" }

return function(Window, meta)

    local Tab = Window:CreateTab({
        Name = "Autofarm",
        Icon = "⚔️",
        Order = (meta and meta.Order) or 35,
    })

    local EnemySection    = Tab:CreateSection({ Name = "Enemies" })
    local PrioritySection = Tab:CreateSection({ Name = "Priorities" })
    local SettingsSection = Tab:CreateSection({ Name = "Settings" })

    ------------------------------------------------------------
    -- State
    ------------------------------------------------------------

    local Enabled         = false
    local Thread          = nil
    local Delay           = 0.3      -- 300 ms between attacks
    local TeleportHeight  = 3
    local SelectedEnemies = {}
    local SelectedMutations = {}

    local ToggleWidget -- set below, referenced by the keybind

    ------------------------------------------------------------
    -- Helpers
    ------------------------------------------------------------

    -- "Buni" should also match "Buni1234", but never "DireBuni"
    local function NameMatches(Name, Pattern)
        if Name == Pattern then return true end
        if Name:sub(1, #Pattern) ~= Pattern then return false end
        return Name:sub(#Pattern + 1):match("^%d+$") ~= nil
    end

    local function PassesFilter(Name)
        local Pool = (#SelectedEnemies > 0) and SelectedEnemies or ENEMY_LIST
        for _, Pattern in ipairs(Pool) do
            if NameMatches(Name, Pattern) then return true end
        end
        return false
    end

    local function GetHitbox(Model)
        local Hitbox = Model:FindFirstChild("Hitbox", true)
        if Hitbox and Hitbox:IsA("MeshPart") then return Hitbox end
        return nil
    end

    local function IsEnemy(Model)
        if not Model:IsA("Model") then return false end
        if not Model:FindFirstChildWhichIsA("Humanoid") then return false end
        return GetHitbox(Model) ~= nil
    end

    local function HasMutation(Model, Mutation)
        local Emitter = Model:FindFirstChild(Mutation, true)
        local Light   = Model:FindFirstChild(Mutation .. "L", true)
        if not (Emitter and Light) then return false end
        if not Emitter:IsA("ParticleEmitter") then return false end
        if not Light:IsA("PointLight") then return false end
        return Emitter.Enabled and Light.Enabled
    end

    local function ScanEnemies()
        local List = {}
        for _, Obj in ipairs(workspace:GetChildren()) do
            if IsEnemy(Obj) and PassesFilter(Obj.Name) then
                table.insert(List, Obj)
            end
        end
        return List
    end

    local function DistanceTo(Model)
        local Character = LocalPlayer.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        if not Root then return math.huge end
        local Hitbox = GetHitbox(Model)
        if not Hitbox then return math.huge end
        return (Hitbox.Position - Root.Position).Magnitude
    end

    ------------------------------------------------------------
    -- Target selection
    ------------------------------------------------------------

    local function PickTarget()
        local Enemies = ScanEnemies()
        if #Enemies == 0 then return nil end

        -- priority mutations first, in the order the user selected them
        for _, Mutation in ipairs(SelectedMutations) do
            local Best, BestDist = nil, math.huge
            for _, Enemy in ipairs(Enemies) do
                if HasMutation(Enemy, Mutation) then
                    local Dist = DistanceTo(Enemy)
                    if Dist < BestDist then
                        BestDist = Dist
                        Best     = Enemy
                    end
                end
            end
            if Best then return Best end
        end

        -- fallback: closest non-mutated enemy from the filtered pool
        local Closest, MinDist = nil, math.huge
        for _, Enemy in ipairs(Enemies) do
            local Dist = DistanceTo(Enemy)
            if Dist < MinDist then
                MinDist = Dist
                Closest = Enemy
            end
        end
        return Closest
    end

    ------------------------------------------------------------
    -- Attack
    ------------------------------------------------------------

    local function Attack(Enemy)
        local Character = LocalPlayer.Character
        if not Character then return end

        local Hitbox = GetHitbox(Enemy)
        if not Hitbox then return end

        local Pos = Hitbox.Position

        -- CFly: teleport straight above the hitbox
        Character:PivotTo(CFrame.new(Pos + Vector3.new(0, TeleportHeight, 0)))

        -- SwingSword: ("L", false, Vector3)
        SwingSword:FireServer("L", false, Pos)
        -- WeaponArt: (nil, true, Vector3)
        WeaponArt:FireServer(nil, true, Pos)
    end

    ------------------------------------------------------------
    -- Loop
    ------------------------------------------------------------

    local function Stop()
        Enabled = false
        if Thread then
            pcall(task.cancel, Thread)
            Thread = nil
        end
    end

    local function Start()
        Stop()
        Enabled = true

        Thread = task.spawn(function()
            while Enabled do
                local Target = PickTarget()
                if Target then
                    Attack(Target)
                end
                task.wait(Delay)
            end
        end)
    end

    -- single entry point: used by both the Toggle and the Keybind
    -- so the two controls can never fall out of sync
    local function SetEnabled(State)
        if State then
            Start()
        else
            Stop()
        end
        if ToggleWidget then
            ToggleWidget:SetValue(Enabled) -- SetValue does not fire Callback, so no loop
        end
    end

    ------------------------------------------------------------
    -- Widgets
    ------------------------------------------------------------

    EnemySection:AddDropdown({
        Text = "Farm Enemies (empty = all)",
        Options = ENEMY_LIST,
        MultiSelect = true,
        Default = {},
        Callback = function(Values)
            SelectedEnemies = Values
        end
    })

    PrioritySection:AddDropdown({
        Text = "Priority Mutations",
        Options = MUTATION_LIST,
        MultiSelect = true,
        Default = {},
        Callback = function(Values)
            SelectedMutations = Values -- order matters: first pick wins first
        end
    })

    ToggleWidget = SettingsSection:AddToggle({
        Text = "Enable Autofarm",
        Default = false,
        Callback = function(Value)
            SetEnabled(Value)
        end
    })

    SettingsSection:AddKeybind({
        Text = "Autofarm Hotkey",
        Default = Enum.KeyCode.F,
        Callback = function()
            SetEnabled(not Enabled)
        end
    })

    SettingsSection:AddSlider({
        Text = "Attack Delay (s)",
        Min = 0.1,
        Max = 1.0,
        Default = Delay,
        Increment = 0.05,
        Callback = function(Value)
            Delay = Value -- takes effect immediately, even while Enabled
        end
    })

    SettingsSection:AddSlider({
        Text = "Teleport Height",
        Min = 0,
        Max = 15,
        Default = TeleportHeight,
        Increment = 0.5,
        Callback = function(Value)
            TeleportHeight = Value
        end
    })

    -- kill the loop on respawn/death, otherwise the old Character reference
    -- keeps getting pivoted for a frame before the model is destroyed
    LocalPlayer.CharacterRemoving:Connect(Stop)

end
